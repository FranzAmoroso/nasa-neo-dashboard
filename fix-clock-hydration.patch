From: Claude <noreply@anthropic.com>
Date: Tue, 10 Nov 2026 19:56:05 +0100
Subject: [PATCH] Fix hydration error: render the clock only in the browser

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WRCGLX7f8JMNcUcuco6B5d
---
 frontend/src/components/Dashboard.jsx | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/frontend/src/components/Dashboard.jsx b/frontend/src/components/Dashboard.jsx
index 0e87e21..abb71e6 100644
--- a/frontend/src/components/Dashboard.jsx
+++ b/frontend/src/components/Dashboard.jsx
@@ -68,7 +68,12 @@ export default function Dashboard() {
       clearInterval(id);
     };
   }, [load]);
+  // L'ora si mostra solo nel browser: sul server di Vercel l'ora e il fuso orario
+  // sono diversi e React segnalerebbe un errore di idratazione (#418).
+  const [mounted, setMounted] = useState(false);
   useEffect(() => {
+    setMounted(true);
+    setNow(Date.now());
     const id = setInterval(() => setNow(Date.now()), 15000);
     return () => clearInterval(id);
   }, []);
@@ -225,7 +230,7 @@ export default function Dashboard() {
 
         <p className="clock">
           <span className="sr">Current date and time: </span>
-          {dClock.format(now)}
+          {mounted ? dClock.format(now) : " "}
         </p>
 
         {showCharts && status === "ready" && (
